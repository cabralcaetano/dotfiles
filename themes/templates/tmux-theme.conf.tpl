# Gerado por theme-set.sh — NÃO editar à mão, sobrescrito a cada troca de tema.
set -g @tmux_power_theme '{{ accent }}'
set -g @tmux_power_g0 "{{ background }}"
set -g @tmux_power_g1 "{{ surface }}"
set -g @tmux_power_g2 "{{ surface_hover }}"
set -g @tmux_power_g3 "{{ color8 }}"
set -g @tmux_power_g4 "{{ foreground }}"
set -g window-style "fg={{ term_foreground }},bg=default"
set -g window-active-style "fg={{ term_foreground }},bg=default"
set -g cursor-colour "{{ term_cursor }}"
