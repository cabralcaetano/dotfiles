/* Gerado por theme-set.sh — NÃO editar à mão, sobrescrito a cada troca de tema.
 * Fonte: themes/<tema>/colors.toml
 * Importado por userChrome.css. */
:root {
  --qb-bg: {{ background }};
  --qb-surface: {{ surface }};
  --qb-surface-hover: {{ surface_hover }};
  --qb-fg: {{ foreground }};
  --qb-fg-dim: {{ color8 }};
  --qb-accent: {{ accent }};
  --qb-error: {{ error }};
}
