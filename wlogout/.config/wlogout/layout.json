{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "󰌾\nLock",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "󰒲\nSuspend",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "󰍃\nLogout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "󰐥\nShutdown",
    "keybind" : "p"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "󰑓\nReboot",
    "keybind" : "r"
}
