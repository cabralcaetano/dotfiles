{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "s"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "power-confirm.sh poweroff",
    "text" : "Shutdown",
    "keybind" : "p"
}
{
    "label" : "reboot",
    "action" : "power-confirm.sh reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
