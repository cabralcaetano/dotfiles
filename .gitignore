# Logs e backups
*.log
*.bak
.DS_Store

# Artefatos do GNU Stow
.stow-local-ignore
*.stow

# Estado volátil do Obsidian (muda a cada sessão)
obsidian/workspace.json
obsidian/workspace-mobile.json

# Cache / runtime
*.tmp
*.swp

# Plugins do tmux (TPM clona aqui por causa do symlink XDG ~/.config/tmux →
# este diretório — não versionar, bootstrap.sh recria via TPM)
tmux/.config/tmux/plugins/

# Plugins de terceiros do Obsidian (builds minificados, reinstaláveis pela loja
# — community-plugins.json já registra quais habilitar). Plugins de código
# próprio ficam versionados via exceção abaixo.
obsidian/plugins/*
!obsidian/plugins/obsidian-default-zoom-fixer/
