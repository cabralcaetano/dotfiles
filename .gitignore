# Logs e backups
*.log
*.bak
.DS_Store

# Artefatos do GNU Stow
.stow-local-ignore
*.stow

# Estado volátil do Obsidian (muda a cada sessão)
obsidian/workspace.json
obsidian/workspace-mobile.json

# Cache / runtime
*.tmp
*.swp
**/icon-theme.cache

# Plugins do tmux (TPM clona aqui por causa do symlink XDG ~/.config/tmux →
# este diretório — não versionar, bootstrap.sh recria via TPM)
tmux/.config/tmux/plugins/

# Plugins de terceiros do Obsidian: builds minificados, reinstaláveis pela
# loja (community-plugins.json já registra quais habilitar). Não vendorizar.
obsidian/plugins/*

# Rede de proteção contra segredos — nenhuma credencial deve ser versionada
# aqui. Os padrões abaixo existem para um `git add -A` distraído não subir
# chave, token ou sessão por acidente.
*.env
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519
*token*
*secret*
*credential*
*cookies*
*session*
