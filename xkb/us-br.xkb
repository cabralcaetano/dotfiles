  partial alphanumeric_keys modifier_keys
  xkb_symbols "us-br" {
      name[Group1]= "English (US, BR programmer)";

      key <RCTL> {
          type[Group1] = "ONE_LEVEL",
          symbols[Group1] = [ ISO_Level3_Shift ]
      };

      key <AC10> { [ semicolon, colon, ccedilla, Ccedilla ] };
  };
