[Unit]
Description=Backup incremental de $HOME para o VPS (restic via SFTP)
# Servidor fora do ar: o script sai 0 com um log; não é falha de unit.
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/backup-restic.sh backup
Nice=10
IOSchedulingClass=idle
# Backup completo de ~ pode passar de uma hora na primeira execução.
TimeoutStartSec=6h
