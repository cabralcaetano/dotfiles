{
  // === BAR =====================================
  "layer": "top",
  "position": "top",
  "passthrough": false,
  "reload_on_style_change": true,

  // === MARGENS =================================
  "spacing": 10,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 1,

  // === MÓDULOS =================================
  "modules-left": ["custom/icon", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["group/tray-drawer", "network", "bluetooth", "pulseaudio", "custom/power-profile", "custom/battery-conservation"],

  // === CPU =====================================
  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    "on-click": "ghostty -e btop"
  },

  // === MEMÓRIA ==================================
  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  // === ÍCONE CUSTOM ============================
  "custom/icon": {
    "format": ""
  },

  // === WORKSPACES ==============================
  "hyprland/workspaces": {
    "disable-scroll": true,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "i",
      "2": "ii",
      "3": "iii",
      "4": "iv",
      "5": "v",
      "6": "vi",
      "7": "vii",
      "8": "viii",
      "9": "ix",
      "10": "x"
    }
  },

  // === JANELA ATIVA ============================
  "hyprland/window": {
    "separate-outputs": true,
    "max-length": 20,
    "format": "{class}"
  },

  // === RELÓGIO =================================
  "clock": {
    "format": "{:%a %d %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<b>{}</b>"
      }
    },
    "on-click": "swaync-client -t",
    "actions": {
      "on-click-right": "shift_down",
      "on-click": "shift_up"
      // "on-double-click": "gnome-calendar"
    }
  },

  // === BATERIA =================================
  "battery": {
  "adapter": "ADP0",
  "bat": "BAT0",
  "format": "{icon} {capacity}%",
  "format-charging": "󰂄 {capacity}%",
  "format-not-charging": "󰚥 {capacity}%",
  "format-full": "󰁹 {capacity}%",
  "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  // === VELOCIDADE DE REDE =======================
  "network#speed": {
    "interval": 2,
    "format": "↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
    "tooltip": false
  },

  // === TRAY COM DRAWER =========================
  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "transition-left-to-right": false
    },
    "modules": ["custom/tray-arrow", "cpu", "memory", "network#speed", "tray"]
  },

  "custom/tray-arrow": {
    "format": "&lt;",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 5,
    "show-passive-items": true,
    "ignore-pattern": "nm-applet"
  },

  // === REDE ====================================
"network": {
  "format-wifi": "{icon}",
  "format-ethernet": "󰈀",
  "format-disconnected": "󰤭",
  "format-icons": ["󰤯", "󰤢", "󰤥", "󰤨"],
  "on-click": "wifi-menu.sh",
  "tooltip-format-wifi": "{essid} {signalStrength}%"
  },

  // === BLUETOOTH ================================
"bluetooth": {
  "format": "󰂯",
  "format-connected": "󰂱",
  "format-off": "󰂲",
  "on-click": "overskride",
  "tooltip": true,
  "tooltip-format-connected": "{device_alias}\nBateria: {device_battery_percentage}%"
  },

  // === PULSEAUDIO ================================
"pulseaudio": {
  "format": "{icon}",
  "icon-size": 16,
  "format-muted": "󰖁",
  "format-icons": {
    "default": ["󰕿", "󰖀", "󰕾"]
  },
  "tooltip": true,
  "tooltip-format": "{volume}%",
  "scroll-step": 5,
  "on-click": "pavucontrol"
  },

  // === POWER ====================================
  "custom/power": {
  "format": "",
  "on-click": "wlogout",
  "tooltip": false
  },

  // === PERFIL DE ENERGIA ========================
  "custom/power-profile": {
    "exec": "power-profile.sh waybar",
    "exec-if": "power-profile.sh waybar-check",
    "interval": 3,
    "tooltip": true,
    "tooltip-format": "Perfil de energia ativo"
  },
  
  // === CONSERVAÇÃO DA BATERIA ===================
  "custom/battery-conservation": {
    "exec": "battery-conservation.sh waybar",
    "exec-if": "battery-conservation.sh waybar-check",
    "interval": 5,
    "format": "{}",
    "on-click": "battery-conservation.sh",
    "tooltip": true,
    "tooltip-format": "Conservação da bateria: clique para alternar Long_Life/100%"
  }
}

  