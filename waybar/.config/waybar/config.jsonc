{
  // === BAR =====================================
  "layer": "top",
  "position": "top",
  "passthrough": false,
  "reload_on_style_change": true,

  // === MARGENS =================================
  "spacing": 10,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 1,

  // === MÓDULOS =================================
  "modules-left": ["custom/icon", "custom/super-workspace", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["group/tray-drawer", "cpu", "memory", "network", "bluetooth", "pulseaudio", "custom/power-profile", "custom/battery-conservation", "custom/swaync-hotspot"],

  // === CPU =====================================
  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    // Ghostty/GTK consome padding: 84×25 entrega terminal efetivo 80×24.
    "on-click": "ghostty --gtk-single-instance=false --title=btop --window-save-state=never --window-decoration=none --window-width=84 --window-height=25 -e btop"
  },

  // === MEMÓRIA ==================================
  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  // === ÍCONE CUSTOM ============================
  "custom/icon": {
    "format": ""
  },

  // === SUPER WORKSPACE ATIVO ====================
  // Só o ícone (sem nome) do super workspace ativo — mapa em icon_for()
  // dentro de super-workspace.sh. Reescrito/recarregado pelo próprio script
  // no SUPER+W — não tem exec/interval porque só muda por reload da barra.
  "custom/super-workspace": {
    "exec": "~/.local/bin/super-workspace.sh waybar",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.local/bin/super-workspace.sh next",
    "on-click-right": "~/.local/bin/super-workspace.sh prev"
  },

  // === WORKSPACES ==============================
  // Só mostra os workspaces do super workspace ativo — ignore-workspaces é
  // reescrito por super-workspace.sh a cada troca (SUPER+W/click).
  "hyprland/workspaces": {
    "disable-scroll": false,
    "tooltip": false,
    "format": "{icon}",
    "ignore-workspaces": ["^(?!super-2-).*$"],
    "format-icons": {
      "super-1-1": "i",
      "super-1-2": "ii",
      "super-1-3": "iii",
      "super-1-4": "iv",
      "super-1-5": "v",
      "super-1-6": "vi",
      "super-1-7": "vii",
      "super-1-8": "viii",
      "super-1-9": "ix",
      "super-1-10": "x",
      "super-2-1": "i",
      "super-2-2": "ii",
      "super-2-3": "iii",
      "super-2-4": "iv",
      "super-2-5": "v",
      "super-2-6": "vi",
      "super-2-7": "vii",
      "super-2-8": "viii",
      "super-2-9": "ix",
      "super-2-10": "x"
    }
  },

  // === JANELA ATIVA ============================
  "hyprland/window": {
    "separate-outputs": true,
    "max-length": 20,
    "tooltip": false,
    "format": "{class}",
    "rewrite": {
      "^com\\.mitchellh\\.ghostty$": "ghostty"
    }
  },

  // === RELÓGIO =================================
  "clock": {
    "locale": "pt_BR.UTF-8",
    "format": "{:%a %d %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<b>{}</b>"
      }
    },
    "on-click": "$HOME/.local/bin/clock-panel-toggle.sh",
    "actions": {
      "on-click-right": "shift_down"
    }
  },

  // === BATERIA =================================
  "battery": {
  "adapter": "ADP0",
  "bat": "BAT0",
  "format": "{icon} {capacity}%",
  "format-charging": "󰂄 {capacity}%",
  "format-not-charging": "󰚥 {capacity}%",
  "format-full": "󰁹 {capacity}%",
  "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  // === VELOCIDADE DE REDE =======================
  "network#speed": {
    "interval": 2,
    "format": "↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
    "tooltip": false
  },

  // === TRAY COM DRAWER =========================
  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "transition-left-to-right": false
    },
    "modules": ["custom/tray-arrow", "network#speed", "tray"]
  },

  "custom/tray-arrow": {
    "format": "&lt;",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 5,
    "show-passive-items": true,
    "ignore-pattern": "nm-applet"
  },

  // === REDE ====================================
"network": {
  "format-wifi": "{icon}",
  "format-ethernet": "󰈀",
  "format-disconnected": "󰤭",
  "format-icons": ["󰤯", "󰤢", "󰤥", "󰤨"],
  "on-click": "$HOME/.local/bin/wifi-menu.sh",
  "tooltip-format-wifi": "{essid} {signalStrength}%"
  },

  // === BLUETOOTH ================================
"bluetooth": {
  "format": "󰂯",
  "format-connected": "󰂱",
  "format-off": "󰂲",
  "on-click": "overskride",
  "tooltip": true,
  "tooltip-format-connected": "{device_alias}\nBateria: {device_battery_percentage}%"
  },

  // === PULSEAUDIO ================================
"pulseaudio": {
  "format": "{icon}",
  "icon-size": 16,
  "format-muted": "󰖁",
  "format-icons": {
    "default": ["󰕿", "󰖀", "󰕾"]
  },
  "tooltip": true,
  "tooltip-format": "{volume}%",
  "scroll-step": 5,
  "on-click": "pavucontrol"
  },


  // === POWER ====================================
  "custom/power": {
  "format": "",
  "on-click": "wlogout",
  "tooltip": false
  },

  // === INDICADOR DE PERFIL DE ENERGIA ===========
  // Sem on-click — só indicador. Some quando o perfil é Balanceado (padrão);
  // aparece com ícone de raio/economia quando foge disso. O clique pra
  // trocar de perfil fica no ícone de bateria, ao lado.
  "custom/power-profile": {
    "exec": "$HOME/.local/bin/power-profile.sh waybar",
    "exec-if": "$HOME/.local/bin/power-profile.sh waybar-check",
    "interval": 3,
    "tooltip": true,
    "tooltip-format": "Perfil de energia"
  },

  // === BATERIA / PERFIL DE ENERGIA ==============
  // Ícone reflete carga/conservação; clique alterna o perfil do tuned
  // (Balanceado/Performance/Economia) em vez da conservação — o notebook
  // fica em Balanceado por padrão, então não faz sentido um ícone dedicado.
  // return-type json: tooltip vem do script (perfil · preservação/100%).
  "custom/battery-conservation": {
    "exec": "$HOME/.local/bin/battery-conservation.sh waybar",
    "exec-if": "$HOME/.local/bin/battery-conservation.sh waybar-check",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "on-click": "$HOME/.local/bin/power-profile.sh",
    "tooltip": true
  },

  // === HOTSPOT INVISÍVEL SWAYNC ==================
  "custom/swaync-hotspot": {
    "format": " ",
    "on-click": "swaync-client -t",
    "tooltip": false
  }
}

  