# === Fonte ===
font-family = JetBrainsMono Nerd Font
font-size = 13

# === Tema — gerado por theme-set.sh, ver themes/ no root do repo ===
config-file = colors.ghostty

# === Transparência ===
background-opacity = 0.78
background-blur = false

# === Janela ===
window-padding-x = 12
window-padding-y = 8
window-save-state = always
gtk-single-instance = true

# === Cursor ===
cursor-style = bar
cursor-style-blink = true

# === Scrollback ===
scrollback-limit = 50000

# === Scroll via teclado (linha a linha) ===
# shift+up/down ficam livres para o adjust_selection padrão do Ghostty
keybind = ctrl+shift+up=scroll_page_lines:-1
keybind = ctrl+shift+down=scroll_page_lines:1

# === Abas via tmux, não via Ghostty ===
# solta ctrl+shift+t/w (default: new_tab/close_tab) para o tmux tratar como
# nova janela / fechar janela — ver tmux.conf
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind

# Alt+Shift+1..0 deve chegar ao tmux como Alt+!/…/) para reposicionar a
# janela atual nos slots 1..10. Usamos códigos físicos para não depender do
# layout nem do protocolo de teclas que o Ghostty escolhe para modificadores.
keybind = alt+shift+Digit1=text:\x1b!
keybind = alt+shift+Digit2=text:\x1b@
keybind = alt+shift+Digit3=text:\x1b#
keybind = alt+shift+Digit4=text:\x1b$
keybind = alt+shift+Digit5=text:\x1b%
keybind = alt+shift+Digit6=text:\x1b^
keybind = alt+shift+Digit7=text:\x1b&
keybind = alt+shift+Digit8=text:\x1b*
keybind = alt+shift+Digit9=text:\x1b(
keybind = alt+shift+Digit0=text:\x1b)

# === Copiar via tmux, não via Ghostty ===
# C-S-c não é imprimível: `unbind` só repassa teclas imprimíveis ao processo
# filho. Enviamos CSI-u explicitamente para o tmux distinguir C-S-c de C-c
# com extended-keys e copiar a seleção de copy-mode via wl-copy.
keybind = ctrl+shift+c=text:\x1b[99;6u

