# === Fonte ===
font-family = JetBrainsMono Nerd Font
font-size = 13

# === Tema — Adwaita dark (cores idênticas ao Kitty) ===
background = #1d1d20
foreground = #deddda
cursor-color = #deddda
cursor-text = #1d1d20
selection-background = #303030
selection-foreground = #c0bfbc
palette = 0=#1d1d20
palette = 1=#ed333b
palette = 2=#57e389
palette = 3=#ff7800
palette = 4=#62a0ea
palette = 5=#9141ac
palette = 6=#5bc8af
palette = 7=#deddda
palette = 8=#9a9996
palette = 9=#f66151
palette = 10=#8ff0a4
palette = 11=#ffa348
palette = 12=#99c1f1
palette = 13=#dc8add
palette = 14=#93ddc2
palette = 15=#f6f5f4

# === Transparência ===
background-opacity = 0.85
background-blur-radius = 20

# === Janela ===
window-padding-x = 12
window-padding-y = 8
window-save-state = always
gtk-single-instance = true

# === Cursor ===
cursor-style = bar
cursor-style-blink = true

# === Scrollback ===
scrollback-limit = 50000
