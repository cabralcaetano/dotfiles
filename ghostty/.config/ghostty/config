# === Fonte ===
font-family = JetBrainsMono Nerd Font
font-size = 13

# === Tema — gerado por theme-set.sh, ver themes/ no root do repo ===
config-file = colors.ghostty

# === Transparência ===
background-opacity = 0.78
background-blur-radius = 20

# === Janela ===
window-padding-x = 12
window-padding-y = 8
window-save-state = always
gtk-single-instance = true

# === Cursor ===
cursor-style = bar
cursor-style-blink = true

# === Scrollback ===
scrollback-limit = 50000

# === Scroll via teclado (linha a linha) ===
# shift+up/down ficam livres para o adjust_selection padrão do Ghostty
keybind = ctrl+shift+up=scroll_page_lines:-1
keybind = ctrl+shift+down=scroll_page_lines:1

# === Abas via tmux, não via Ghostty ===
# solta ctrl+shift+t/w (default: new_tab/close_tab) para o tmux tratar como
# nova janela / fechar janela — ver tmux.conf
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind

# === Copiar via tmux, não via Ghostty ===
# com mouse on, a seleção é do tmux — o Ghostty não tem seleção própria pra
# copiar, então ctrl+shift+c (copy_to_clipboard) copiava vazio. Desbindado
# pra que a tecla chegue no tmux, que copia a seleção do copy-mode com
# wl-copy — ver tmux.conf
keybind = ctrl+shift+c=unbind

